{
  "annotations": { "list": [] },
  "editable": true,
  "graphTooltip": 1,
  "links": [],
  "panels": [
    {
      "datasource": { "type": "prometheus", "uid": "${DS_LINGMAI}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [
            { "options": { "0": { "color": "red", "index": 0, "text": "失联" }, "1": { "color": "green", "index": 1, "text": "在线" } }, "type": "value" }
          ],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 1 }] }
        },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "id": 1,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "targets": [{ "expr": "up", "legendFormat": "{{job}}", "refId": "A" }],
      "title": "仙徒在线（up）",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_LINGMAI}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "yellow", "value": 1 }, { "color": "green", "value": 1 }] }
        },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "id": 2,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "targets": [{ "expr": "zhentu_nodes_online", "legendFormat": "在线节点", "refId": "A" }],
      "title": "阵图在线节点",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_LINGMAI}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 45 }, { "color": "red", "value": 48 }] },
          "unit": "celsius"
        },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "id": 3,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "targets": [{ "expr": "sanxian_temperature_celsius", "legendFormat": "散仙电池温度", "refId": "A" }],
      "title": "散仙温度",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_LINGMAI}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [
            { "options": { "0": { "color": "orange", "index": 0, "text": "已降载" }, "1": { "color": "green", "index": 1, "text": "正常" } }, "type": "value" }
          ],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "orange", "value": null }, { "color": "green", "value": 1 }] }
        },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "id": 4,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "targets": [{ "expr": "1 - sanxian_thermal_shedding", "legendFormat": "散热状态", "refId": "A" }],
      "title": "散仙散热",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_LINGMAI}" },
      "fieldConfig": {
        "defaults": { "color": { "mode": "palette-classic" }, "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 1, "showPoints": "never" }, "unit": "short" },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "id": 5,
      "options": { "legend": { "calcs": ["lastNotNull"], "displayMode": "table", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "expr": "sanxian_inflight_requests", "legendFormat": "散仙在途", "refId": "A" },
        { "expr": "sanxian_effective_max_concurrency", "legendFormat": "散仙有效上限", "refId": "B" },
        { "expr": "quasheng_inflight_requests", "legendFormat": "准圣在途", "refId": "C" }
      ],
      "title": "并发占用",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_LINGMAI}" },
      "fieldConfig": {
        "defaults": { "color": { "mode": "palette-classic" }, "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 1, "showPoints": "never" }, "unit": "reqps" },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "id": 6,
      "options": { "legend": { "calcs": ["lastNotNull"], "displayMode": "table", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "expr": "sum by (job) (rate(sanxian_http_requests_total[2m]))", "legendFormat": "{{job}}", "refId": "A" },
        { "expr": "sum by (job) (rate(quasheng_http_requests_total[2m]))", "legendFormat": "{{job}}", "refId": "B" }
      ],
      "title": "请求速率",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_LINGMAI}" },
      "fieldConfig": {
        "defaults": { "color": { "mode": "palette-classic" }, "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 1, "showPoints": "never" }, "unit": "s" },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "id": 7,
      "options": { "legend": { "calcs": ["lastNotNull"], "displayMode": "table", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "expr": "histogram_quantile(0.95, sum by (le) (rate(sanxian_first_byte_seconds_bucket[5m])))", "legendFormat": "散仙首字节 P95", "refId": "A" },
        { "expr": "histogram_quantile(0.95, sum by (le) (rate(sanxian_request_duration_seconds_bucket[5m])))", "legendFormat": "散仙整体 P95", "refId": "B" },
        { "expr": "histogram_quantile(0.95, sum by (le) (rate(quasheng_first_byte_seconds_bucket[5m])))", "legendFormat": "准圣首字节 P95", "refId": "C" }
      ],
      "title": "推理时延 P95",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_LINGMAI}" },
      "fieldConfig": {
        "defaults": { "color": { "mode": "palette-classic" }, "custom": { "drawStyle": "bars", "fillOpacity": 40, "lineWidth": 1, "showPoints": "never" }, "unit": "short" },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "id": 8,
      "options": { "legend": { "calcs": ["lastNotNull"], "displayMode": "table", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "expr": "sum by (status) (increase(sanxian_http_requests_total{status=~\"4..|5..\"}[5m]))", "legendFormat": "散仙 {{status}}", "refId": "A" },
        { "expr": "sum by (status) (increase(quasheng_http_requests_total{status=~\"4..|5..\"}[5m]))", "legendFormat": "准圣 {{status}}", "refId": "B" }
      ],
      "title": "错误响应（4xx/5xx）",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_LINGMAI}" },
      "fieldConfig": {
        "defaults": { "color": { "mode": "palette-classic" }, "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 1, "showPoints": "never" }, "unit": "short" },
        "overrides": []
      },
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 20 },
      "id": 9,
      "options": { "legend": { "calcs": ["lastNotNull"], "displayMode": "table", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "expr": "sanxian_model_loaded", "legendFormat": "散仙 {{model}}", "refId": "A" }
      ],
      "title": "散仙模型加载态",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_LINGMAI}" },
      "fieldConfig": {
        "defaults": { "color": { "mode": "palette-classic" }, "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 1, "showPoints": "never" }, "unit": "short" },
        "overrides": []
      },
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 20 },
      "id": 10,
      "options": { "legend": { "calcs": ["lastNotNull"], "displayMode": "table", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "expr": "sum by (result) (rate(zhentu_route_total[5m]))", "legendFormat": "选路 {{result}}", "refId": "A" },
        { "expr": "sum(rate(zhentu_route_rejected_total[5m]))", "legendFormat": "被拒候选/秒", "refId": "B" }
      ],
      "title": "阵图选路",
      "type": "timeseries"
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": ["lingmai", "biyou-palace"],
  "templating": {
    "list": [
      {
        "current": { "selected": false, "text": "LingMai", "value": "LingMai" },
        "hide": 0,
        "label": "数据源",
        "name": "DS_LINGMAI",
        "options": [],
        "query": "prometheus",
        "refresh": 1,
        "regex": "",
        "skipUrlSync": false,
        "type": "datasource"
      }
    ]
  },
  "time": { "from": "now-1h", "to": "now" },
  "timezone": "browser",
  "title": "灵脉 · 碧游宫集群",
  "uid": "lingmai-cluster",
  "version": 1
}
