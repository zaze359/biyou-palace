# 碧游宫 · 中枢机编排配置模板
#
# 复制为 .env，或直接运行 `bash scripts/bootstrap_cluster.sh` 自动生成随机密钥。
# `.env` 已被 git 忽略；不要把真实 token / 密码写进本文件。

TZ=Asia/Shanghai
BIYOU_VERSION=1.0.0

# ---------------------------------------------------------------------------
# 碧游宫 NewAPI
# ---------------------------------------------------------------------------
NEWAPI_IMAGE=calciumion/new-api:v1.0.0-rc.48
NEWAPI_CONTAINER_NAME=new-api
NEWAPI_PORT=3000
NEWAPI_DATA_DIR=./deploy/newapi/data
NEWAPI_BASE_URL=http://127.0.0.1:3000

# 管理员鉴权（gateway_admin.py 使用；优先级 TOKEN > 用户名/密码 > Cookie 文件）
NEWAPI_ADMIN_USERNAME=root
NEWAPI_ADMIN_PASSWORD=
# NEWAPI_ADMIN_TOKEN=
# NEWAPI_ADMIN_USER_ID=1
# NEWAPI_ADMIN_COOKIE_FILE=/absolute/path/to/cookies.txt

# 客户端调用 key（渠道、验收脚本与阵图共用）
ZHENTU_NEWAPI_API_KEY=

# ---------------------------------------------------------------------------
# 阵图 ZhenTu
# ---------------------------------------------------------------------------
ZHENTU_CONTAINER_NAME=biyou-zhentu
ZHENTU_BIND_ADDR=0.0.0.0
ZHENTU_PORT=4020
# 非回环监听必填；bootstrap 会自动生成
ZHENTU_REGISTRY_TOKEN=
# 可选：给不同节点分配独立 token，JSON 对象 {"node-id":"token"}
ZHENTU_NODE_TOKENS={}
# 置空 = 默认部署不拆步；填入可用模型后阵图才会先规划再执行
ZHENTU_PLANNER_MODEL=
ZHENTU_PLANNER_RETRIES=1
ZHENTU_PLANNER_TIMEOUT_S=30
ZHENTU_AGGREGATOR_MODE=concat
ZHENTU_AGGREGATOR_MODEL=
ZHENTU_AGGREGATOR_TIMEOUT_S=30
ZHENTU_MAX_ACTIVE_TASKS=4
ZHENTU_TASK_EVENT_RETENTION_DAYS=30
ZHENTU_TASK_EVENT_MAX_PER_TASK=10000

# ---------------------------------------------------------------------------
# 灵脉 LingMai
# ---------------------------------------------------------------------------
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
