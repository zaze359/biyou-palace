# 准圣节点环境变量样例
#
# 优先级：环境变量 > config.yaml > 代码默认值
# 本文件只是变量清单：进程不会自动读取 .env，需手动导入后再启动，例如
#   cp nodes/quasheng/.env.example .env
#   set -a && source .env && set +a
#   bash scripts/run_quasheng.sh
#
# 下列 6 项与 config.py 的 _ENV_OVERRIDES 一一对应；留空/注释掉即沿用 YAML 或默认值。
#
# 配置文件路径单独由 QUASHENG_CONFIG 决定（不属于字段覆盖），默认读取当前目录的 config.yaml：
# QUASHENG_CONFIG=/path/to/config.yaml

# Ollama 地址，默认 http://127.0.0.1:11434（本机直连，不走 HTTP(S)_PROXY）
QUASHENG_OLLAMA_BASE=http://127.0.0.1:11434

# 服务端口，默认 4010（避开 Ollama 自身的 11434）
QUASHENG_PORT=4010

# 节点 ID，默认 quasheng-01（写入响应头 X-Node-Id 与 health.node.id）
QUASHENG_NODE_ID=quasheng-01

# 节点显示名，默认 准圣·01（写入 health.node.name）
QUASHENG_NODE_NAME=准圣·01

# 共享 bearer token，默认空；非空即自动开启鉴权（覆盖全部端点，含 /v1/health）
QUASHENG_SHARED_TOKEN=

# 并发上限，默认 2；满载立即返回 429 + Retry-After（不做本地排队）
QUASHENG_MAX_CONCURRENCY=2

# 注意：降级阈值 mem_warn_pct / cpu_warn_pct 与 preload_models、capabilities_map、
#       request_timeout 等暂无环境变量覆盖，只能写在 config.yaml。
